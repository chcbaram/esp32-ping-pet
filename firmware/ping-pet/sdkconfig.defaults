CONFIG_IDF_TARGET="esp32p4"

# JC4880P443C: ESP32-P4 rev v3.2 (esptool로 확인), 400 MHz
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# 새 펌웨어가 부팅해 ota 모듈이 정상이라고 표시하기 전에 리셋되면 이전 펌웨어로 되돌린다
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_SPIRAM=y
# PSRAM 200 MHz : PPA 회전이 PSRAM 대역폭에 묶인다 (docs/23). ESPHome 의 이 보드 설정과 같다
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

CONFIG_FREERTOS_HZ=1000

# USB CDC: P4 USB 2.0 HS OTG (esp_tinyusb 기본값이 HS 포트). 디스크립터는 usb_desc.c
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1

# LVGL 9.6 (stm32h7-lvgl 의 lv_conf.h 값을 옮겼다)
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_28=y
CONFIG_LV_USE_SYSMON=y
# 성능 표시(FPS, CPU)는 개발할 때만 켠다
# CONFIG_LV_USE_PERF_MONITOR is not set
# 한글 · 픽셀 폰트는 TTF 를 펌웨어에 넣고 실행 중에 그린다 (Tiny TTF, docs/24)
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_CACHE_GLYPH_CNT=256

# 플래시를 쓰는 동안(OTA 등) 캐시가 멈춰도 DPI 인터럽트가 돌게 한다. 꺼져 있으면 OTA 중 화면이 깜빡인다
CONFIG_LCD_DSI_ISR_CACHE_SAFE=y
